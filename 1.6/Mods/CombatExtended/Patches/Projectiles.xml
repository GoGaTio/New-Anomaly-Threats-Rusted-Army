<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="NAT_RustedBulletBase"]/projectile</xpath>
    <value>
      <thingClass>CombatExtended.BulletCE</thingClass>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>NAT_RustedBullet</damageDef>
      </projectile>
    </value>
  </Operation>

  <!-- ========== Misc ========== -->

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="NAT_Bullet_RustedSmallStop" or defName="NAT_Bullet_RustedMedium" or defName="NAT_Bullet_RustedPistol"]</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Bullet_RustedSmall"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageAmountBase>11</damageAmountBase>
        <armorPenetrationSharp>7</armorPenetrationSharp>
        <armorPenetrationBlunt>30</armorPenetrationBlunt>
        <speed>90</speed>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Bullet_RustedRifle"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageAmountBase>25</damageAmountBase>
        <armorPenetrationSharp>18</armorPenetrationSharp>
        <armorPenetrationBlunt>70</armorPenetrationBlunt>
        <speed>160</speed>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Bullet_RustedLarge"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageAmountBase>40</damageAmountBase>
        <armorPenetrationSharp>37</armorPenetrationSharp>
        <armorPenetrationBlunt>1000</armorPenetrationBlunt>
        <speed>180</speed>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Bullet_RustedHighVelocity"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageAmountBase>100</damageAmountBase>
        <armorPenetrationSharp>75</armorPenetrationSharp>
        <armorPenetrationBlunt>6000</armorPenetrationBlunt>
        <speed>200</speed>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Proj_RustedTremola"]/thingClass</xpath>
    <value>
      <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="NAT_Proj_RustedTremola"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>NAT_RustedBomb</damageDef>
        <damageAmountBase>100</damageAmountBase>
        <armorPenetrationSharp>20</armorPenetrationSharp>
        <armorPenetrationBlunt>500</armorPenetrationBlunt>
        <explosionRadius>1.5</explosionRadius>
        <speed>120</speed>
      </projectile>
    </value>
  </Operation>

</Patch>