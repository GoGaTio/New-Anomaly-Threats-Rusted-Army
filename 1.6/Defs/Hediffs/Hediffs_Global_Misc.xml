<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>NAT_BannerBuff</defName>
    <label>banner boost</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This rust is affected by battle cry and fights better.</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <defaultLabelColor>(160,131,115)</defaultLabelColor>
    <comps>
      <li Class="NAT.HediffCompProperties_RustedBuff">
        <ticksToDecreaseLevel>5000</ticksToDecreaseLevel>
      </li>
<li Class="HediffCompProperties_Effecter">
        <stateEffecter>NAT_BannerBuff</stateEffecter>
      </li>
    </comps>
    <stages>
      <li>
        <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
        <statOffsets>
          <MeleeCooldownFactor>-0.1</MeleeCooldownFactor>
          <MeleeHitChance>1</MeleeHitChance>
          <RangedCooldownFactor>-0.1</RangedCooldownFactor>
          <ShootingAccuracyPawn>1</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NAT_HornBuff</defName>
    <label>horn boost</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This rust is affected by battle cry and fights better.</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <comps>
      <li Class="NAT.HediffCompProperties_RustedBuff">
        <ticksToDecreaseLevel>5000</ticksToDecreaseLevel>
      </li>
<li Class="HediffCompProperties_Effecter">
        <stateEffecter>NAT_BannerBuff</stateEffecter>
      </li>
    </comps>
    <stages>
      <li>
        <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
        <statOffsets>
          <MoveSpeed>0.15</MoveSpeed>
          <IncomingDamageFactor>-0.15</IncomingDamageFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

