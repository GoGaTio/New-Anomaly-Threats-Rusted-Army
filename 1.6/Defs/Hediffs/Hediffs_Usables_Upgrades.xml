<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef Name="NAT_RustedCoreUpgradeBase" Abstract="True">
    <hediffClass>Hediff_Level</hediffClass>
    <defaultLabelColor>(1.0, 0.6, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <priceImpact>true</priceImpact>
    <initialSeverity>0</initialSeverity>
    <!-- Severity is bound to level of implant -->
    <minSeverity>0</minSeverity>
    <maxSeverity>3</maxSeverity>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <levelIsQuantity>true</levelIsQuantity>
    <duplicationAllowed>false</duplicationAllowed>
    <defaultInstallPart>NAT_RustedCore</defaultInstallPart>
  </HediffDef>

  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Amplifier</defName>
    <label>core amplifier</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <MeleeHitChance>4</MeleeHitChance>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <MeleeHitChance>6</MeleeHitChance>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  
  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Stabilizator</defName>
    <label>core stabilizator</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <NAT_CoreDropChance>0.33</NAT_CoreDropChance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <NAT_CoreDropChance>0.66</NAT_CoreDropChance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <NAT_CoreDropChance>0.99</NAT_CoreDropChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Stimulator</defName>
    <label>core stimulator</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <RestFallRateFactor>-0.15</RestFallRateFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <RestFallRateFactor>-0.3</RestFallRateFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <RestFallRateFactor>-0.45</RestFallRateFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Reinforcer</defName>
    <label>core reinforcer</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
          <Flammability>0.85</Flammability>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.8</IncomingDamageFactor>
          <Flammability>0.7</Flammability>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
          <Flammability>0.55</Flammability>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Regenerator</defName>
    <label>core regenerator</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <regeneration>20</regeneration>
        <showRegenerationStat>true</showRegenerationStat>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <regeneration>40</regeneration>
        <showRegenerationStat>true</showRegenerationStat>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <regeneration>60</regeneration>
        <showRegenerationStat>true</showRegenerationStat>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="NAT_RustedCoreUpgradeBase">
    <defName>NAT_CoreUpgrade_Connector</defName>
    <label>core connector</label>
    <description>An implant which increases a mechanitor's control group count and the work speed of a mechanitor's mechs.\n\nThis implant can be installed up to 6 times to increase its effect.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <MechBandwidth>2</MechBandwidth>
          <MechFormingSpeed>0.333</MechFormingSpeed>
          <WorkSpeedGlobalOffsetMech>0.05</WorkSpeedGlobalOffsetMech>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <MechBandwidth>4</MechBandwidth>
          <MechFormingSpeed>0.666</MechFormingSpeed>
          <WorkSpeedGlobalOffsetMech>0.1</WorkSpeedGlobalOffsetMech>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <MechBandwidth>6</MechBandwidth>
          <MechFormingSpeed>1</MechFormingSpeed>
          <WorkSpeedGlobalOffsetMech>0.15</WorkSpeedGlobalOffsetMech>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
