<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingCategoryDef>
    <defName>NAT_RustedEquipment</defName>
    <label>rusted equipment</label>
    <parent>Items</parent>
  </ThingCategoryDef>

  <ThingDef Abstract="True" Name="NAT_WeaponUsablyByRust">
    <techLevel>Archotech</techLevel>
    <tradeability>None</tradeability>
    <destroyOnDrop>false</destroyOnDrop>
    <relicChance>0</relicChance>
    <smeltable>false</smeltable>
    <soundInteract>Interact_Revolver</soundInteract>
    <thingCategories>
      <li>NAT_RustedEquipment</li>
    </thingCategories>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <weaponTags>
      <li>NoSwitch</li>
    </weaponTags>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <drawGUIOverlay>true</drawGUIOverlay>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <tickerType>Never</tickerType>
    <equipmentType>Primary</equipmentType>
    <useHitPoints>true</useHitPoints>
    <pathCost>14</pathCost>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.5</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Beauty>-4</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

  <ThingDef Abstract="True" ParentName="NAT_WeaponUsablyByRust" Name="NAT_BaseRustedWeapon">
    <statBases>
      <MarketValue>500</MarketValue>
    </statBases>
    <thingSetMakerTags>
      <li>NAT_RustedWeapon</li>
    </thingSetMakerTags>
    <graphicData>
      <drawSize>1.15</drawSize>
    </graphicData>
    <weaponTags>
      <li>NAT_RustedMedium</li>
    </weaponTags>
    <techLevel>Archotech</techLevel>
    <tradeability>None</tradeability>
    <destroyOnDrop>false</destroyOnDrop>
    <relicChance>0</relicChance>
    <soundInteract>Interact_Revolver</soundInteract>
    <comps>
      <li Class="NAT.CompProperties_RustedEquipment" />
      <li Class="NAT.CompProperties_ConverterSubject">
        <useButchery>true</useButchery>
        <categoryKey>NAT_RustedEquipment</categoryKey>
        <butcheryRandomOffsetPct>0.2</butcheryRandomOffsetPct>
      </li>
    </comps>
  </ThingDef>

  <ThingDef Abstract="True" ParentName="NAT_BaseRustedWeapon" Name="NAT_BaseRustedSidearm">
    <weaponTags>
      <li>NAT_RustedSidearm</li>
    </weaponTags>
    <tickerType>Normal</tickerType>
    <soundInteract>Standard_Pickup</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <generateCommonality>0.25</generateCommonality>
    <comps>
      <li Class="NAT.CompProperties_RustedSidearm" />
    </comps>
  </ThingDef>

  <ThingDef Abstract="True" ParentName="NAT_WeaponUsablyByRust" Name="NAT_BaseHeavyRustedWeapon">
    <statBases>
      <MarketValue>1100</MarketValue>
    </statBases>
    <thingSetMakerTags>
      <li>NAT_HeavyRustedWeapon</li>
    </thingSetMakerTags>
    <weaponTags>
      <li>NAT_RustedHeavy</li>
    </weaponTags>
    <techLevel>Archotech</techLevel>
    <tradeability>None</tradeability>
    <destroyOnDrop>false</destroyOnDrop>
    <relicChance>0</relicChance>
    <soundInteract>Interact_Revolver</soundInteract>
    <comps>
      <li Class="NAT.CompProperties_RustedEquipment">
        <minBodySize>1.3</minBodySize>
      </li>
      <li Class="NAT.CompProperties_ConverterSubject">
        <useButchery>true</useButchery>
        <categoryKey>NAT_RustedEquipment</categoryKey>
        <butcheryRandomOffsetPct>0.2</butcheryRandomOffsetPct>
      </li>
    </comps>
  </ThingDef>

  <ThingDef Abstract="True" Name="NAT_RustedTurretWeapon" ParentName="BaseWeaponTurret">
    <techLevel>Archotech</techLevel>
    <statBases>
      <AccuracyTouch>0.28</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.5</AccuracyLong>
      <RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>40</Mass>
      <Flammability>2</Flammability>
    </statBases>
  </ThingDef>

</Defs>