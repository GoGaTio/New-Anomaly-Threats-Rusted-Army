<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="NAT_BaseRustedWeapon">
    <defName>NAT_Gun_RustedMachinePistol</defName>
    <label>rusted machine pistol</label>
    <description>A micro-submachine gun. It is short-ranged, but very light in the hands. Its rate of fire tends to make up for its weakness.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Weapon/NAT_RustedMachinePistol</texPath>
    </graphicData>
    <generateCommonality>0.2</generateCommonality>
    <weaponTags>
      <li>NAT_RustedMachinePistol</li>
    </weaponTags>
    <statBases>
      <Mass>2</Mass>
      <AccuracyTouch>0.90</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.35</AccuracyMedium>
      <AccuracyLong>0.15</AccuracyLong>
      <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>NAT_Bullet_RustedPistol</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>19.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>Shot_MachinePistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>NAT_RustedScratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>NAT_RustedScratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <butcherProducts>
      <Bioferrite>11</Bioferrite>
    </butcherProducts>
  </ThingDef>

