<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================= Industrial ==================================== -->

  <ThingDef Name="NAT_RustedBulletBase" Abstract="True" ParentName="BaseBullet">
    <graphicData>
      <color>(255,30,30)</color>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <projectile>
      <damageDef>NAT_RustedBullet</damageDef>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedSmall</defName>
    <label>rusted bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
    </graphicData>
    <projectile>
      <damageAmountBase>9</damageAmountBase>
      <armorPenetrationBase>0.2</armorPenetrationBase>
      <speed>60</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedSmallStop</defName>
    <label>rusted bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
    </graphicData>
    <projectile>
      <damageAmountBase>13</damageAmountBase>
      <stoppingPower>1</stoppingPower>
      <speed>50</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedRifle</defName>
    <label>rusted bullet</label>
    <projectile>
      <damageAmountBase>19</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <armorPenetrationBase>0.44</armorPenetrationBase>
      <speed>80</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Bullet_big</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedMedium</defName>
    <label>rusted bullet</label>
    <projectile>
      <damageAmountBase>17</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <speed>60</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Bullet_big</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedLarge</defName>
    <label>rusted shell</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
    </graphicData>
    <projectile>
      <damageAmountBase>27</damageAmountBase>
      <stoppingPower>1.8</stoppingPower>
      <speed>88</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedHighVelocity</defName>
    <label>rusted shell</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <drawSize>1.4</drawSize>
    </graphicData>
    <projectile>
      <damageAmountBase>55</damageAmountBase>
      <speed>120</speed>
      <armorPenetrationBase>1</armorPenetrationBase>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Bullet_RustedShotgun</defName>
    <label>rusted shotgun blast</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Shotgun</texPath>
    </graphicData>
    <projectile>
      <damageAmountBase>18</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Proj_RustedTremola</defName>
    <label>rusted bombshell</label>
    <graphicData>
      <texPath>Things/Projectile/LauncherShot</texPath>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>40</speed>
      <damageDef>NAT_RustedBomb</damageDef>
      <explosionRadius>1.9</explosionRadius>
      <arcHeightFactor>2</arcHeightFactor>
      <shadowSize>0.6</shadowSize>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Proj_RustedRocket</defName>
    <label>rusted rocket</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/NAT_RustedShell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
    <projectile>
      <explosionRadius>3.7</explosionRadius>
      <damageDef>NAT_RustedAntiTankBomb</damageDef>
      <damageAmountBase>55</damageAmountBase>
      <speed>80</speed>
    </projectile>
    <comps>
      <li Class="NAT.CompProperties_ConstantFleckEmitter">
        <fleck>NAT_RustedRocketTrail</fleck>
        <startEmitFromTick>0</startEmitFromTick>
        <countEmitPerTick>2</countEmitPerTick>
        <soundOnEmitStart>InfernoCannon_Fire</soundOnEmitStart>
        <sizeCurve>
          <points>
            <li>(0,3)</li>
            <li>(5,2)</li>
            <li>(10,1.5)</li>
            <li>(15,1)</li>
          </points>
        </sizeCurve>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>NAT_Proj_RustedGrenade</defName>
    <label>rusted grenade</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/NAT_RustedGrenade</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>1.9</explosionRadius>
      <damageDef>NAT_RustedBomb</damageDef>
      <explosionDelay>100</explosionDelay>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>NAT_Proj_RustedImpactGrenade</defName>
    <label>rusted impact grenade</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/NAT_RustedImpactGrenade</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>2.9</explosionRadius>
      <damageDef>NAT_RustedBomb</damageDef>
      <explosionDelay>0</explosionDelay>
      <spinRate>2</spinRate>
      <speed>12</speed>
      <preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>NAT_Proj_HateCube</defName>
    <label>hate cube</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/NAT_HateCube</texPath>
      <graphicClass>Graphic_Single_AgeSecs</graphicClass>
      <shaderType>GlowAnimated</shaderType>
      <shaderParameters>
        <_NumFrames>6</_NumFrames>
        <_FramesPerSec>12</_FramesPerSec>
      </shaderParameters>
      <drawSize>3</drawSize>
    </graphicData>
    <projectile>
      <damageDef>NAT_HateVaporize</damageDef>
      <useGraphicClass>True</useGraphicClass>
      <damageAmountBase>30000</damageAmountBase>
      <speed>20</speed>
      <soundAmbient>FleshmelterBolt_Launch</soundAmbient>
      <explosionRadius>2.9</explosionRadius>
      <screenShakeFactor>1.25</screenShakeFactor>
      <filth>Filth_BlastMark</filth>
      <filthCount>1</filthCount>
      <explosionSpawnsSingleFilth>true</explosionSpawnsSingleFilth>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="NAT_RustedBulletBase">
    <defName>NAT_Proj_RustedBigAssRocket</defName>
    <label>rusted bigass rocket</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/NAT_RustedShell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
    <projectile>
      <explosionRadius>12.7</explosionRadius>
      <damageDef>NAT_RustedAntiTankBomb</damageDef>
      <damageAmountBase>550</damageAmountBase>
      <speed>40</speed>
    </projectile>
    <comps>
      <li Class="NAT.CompProperties_ConstantFleckEmitter">
        <fleck>NAT_RustedRocketTrail</fleck>
        <startEmitFromTick>0</startEmitFromTick>
        <countEmitPerTick>1</countEmitPerTick>
        <soundOnEmitStart>InfernoCannon_Fire</soundOnEmitStart>
        <sizeCurve>
          <points>
            <li>(0,8)</li>
            <li>(5,6)</li>
            <li>(10,4.5)</li>
            <li>(15,3)</li>
          </points>
        </sizeCurve>
      </li>
    </comps>
  </ThingDef>

</Defs>
