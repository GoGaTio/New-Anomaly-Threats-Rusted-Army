<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <ThingDef ParentName="NAT_BossCallerBase">
    <defName>NAT_HatebandEmitter</defName>
    <label>hateband emitter</label>
    <description>A mech-band signaling device more powerful than the normal mechband antenna. When activated, it puts out an ultra-powerful mech signal pulse, which will attract a mechanoid commander to attack with its escorts. If you can defeat it, you can collect special technologies from its corpse. The signal pulse burns out the dish, so this building can only be used once.</description>
    <researchPrerequisites>
      <li>NAT_RustCreation</li>
    </researchPrerequisites>
    <comps>
      <li Class="NAT.CompProperties_CallAnomalyBoss">
        <floatingGraphic>
          <texPath>Things/Projectile/NAT_HateCube</texPath>
          <graphicClass>Graphic_Single_AgeSecs</graphicClass>
          <shaderType>GlowAnimated</shaderType>
          <drawSize>(1,1)</drawSize>
          <drawOffset>(0, 0, 1)</drawOffset>
          <drawSize>3</drawSize>
          <shaderParameters>
            <_NumFrames>6</_NumFrames>
            <_FramesPerSec>6</_FramesPerSec>
          </shaderParameters>
        </floatingGraphic>
        <extraFloatingRotation>90</extraFloatingRotation>
        <bossDef>NAT_RustedGeneral</bossDef>
        <effecterDef>NAT_HatebandEmitterUsed</effecterDef>
        <destroyEffecterDef>NAT_HatebandEmitterDestroyed</destroyEffecterDef>
        <activeTicks>1</activeTicks>
        <ticksToActivate>180</ticksToActivate>
        <destroyDelayTicks>120</destroyDelayTicks>
        <jobString>summon rusted general</jobString>
        <activateLabelString>Summon rusted general...</activateLabelString>
        <activateDescString>Summon rusted general.</activateDescString>
        <activatingString>activating {0}: {1}s</activatingString>
        <activateTexPath>UI/Commands/NAT_CallAnomalyBoss</activateTexPath>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </ThingDef>

</Defs>