<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TerrainDef Name="NAT_RustedFloorBase">
    <defName>NAT_RustedFloor</defName>
    <label>rusted surface</label>
    <pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainFadeRoughLinearBurn</pollutionShaderType>
    <pollutionOverlayTexturePath>Terrain/Surfaces/PollutionFloorSmooth</pollutionOverlayTexturePath>
    <pollutionColor>(1, 1, 1, 0.8)</pollutionColor>
    <pollutionOverlayScale>(0.75, 0.75)</pollutionOverlayScale>
    <canEverTerraform>false</canEverTerraform>
    <texturePath>Terrain/NAT_RustedFloor</texturePath>
    <renderPrecedence>393</renderPrecedence>
    <fertility>0</fertility>
    <layerable>true</layerable>
    <designationCategory />
    <pathCost>10</pathCost>
    <edgeType>FadeRough</edgeType>
    <statBases>
      <Beauty>-4</Beauty>
      <Cleanliness>1</Cleanliness>
      <Flammability>0</Flammability>
      <CleaningTimeFactor>0.8</CleaningTimeFactor>
    </statBases>
    <tags>
      <li>NAT_Rusted</li>
    </tags>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
    </affordances>
    <costList>
      <Bioferrite>5</Bioferrite>
    </costList>
    <resourcesFractionWhenDeconstructed>0.1</resourcesFractionWhenDeconstructed>
  </TerrainDef>

  <TerrainDef ParentName="NAT_RustedFloorBase">
    <defName>NAT_AncientCarpet</defName>
    <label>ancient carpet</label>
    <texturePath>Terrain/NAT_AncientFabricCarpet</texturePath>
    <edgeType>Hard</edgeType>
    <costList Inherit="False">
      <NAT_AncientFabric>7</NAT_AncientFabric>
    </costList>
    <statBases>
      <Beauty>1</Beauty>
      <Flammability>0.4</Flammability>
      <WorkToBuild>800</WorkToBuild>
      <CleaningTimeFactor>2</CleaningTimeFactor>
      <BedRestEffectiveness>1.25</BedRestEffectiveness>
    </statBases>
    <renderPrecedence>60</renderPrecedence>
    <pathCost>0</pathCost>
  </TerrainDef>

</Defs>
