<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="NAT_ItemUsableByRust" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <genericMarketSellable>false</genericMarketSellable>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <soundInteract>Standard_Pickup</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>10</stackLimit>
    <intricate>true</intricate>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <Mass>0.1</Mass>
      <Beauty>-6</Beauty>
      <Flammability>1</Flammability>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
  
  <!--============================================Activators======================================================================-->

  <ThingDef Name="NAT_RustActivatorBase" Abstract="True" ParentName="NAT_ItemUsableByRust">
    <thingSetMakerTags>
      <li>NAT_RustedActivator</li>
    </thingSetMakerTags>
    <recipeMaker>
      <researchPrerequisite>NAT_RustedActivators</researchPrerequisite>
      <workAmount>700</workAmount>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <productCount>1</productCount>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <soundWorking>Recipe_Machining</soundWorking>
      <effectWorking>Cook</effectWorking>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>BioferriteShaper</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Bioferrite>20</Bioferrite>
    </costList>
    <uiIconScale>1.35</uiIconScale>
  </ThingDef>

  <ThingDef ParentName="NAT_RustActivatorBase">
    <defName>NAT_RustedActivator_Speed</defName>
    <label>rusted speed activator</label>
    <description>A small device that increases speed of rust.</description>
    <graphicData>
      <texPath>Things/Item/NAT_UsableByRust/NAT_RustedActivator_Speed</texPath>
    </graphicData>
    <statBases>
      <MarketValue>55</MarketValue>
    </statBases>
    <comps>
      <li Class="NAT.CompProperties_UsableByRust">
        <hediff>NAT_ActivatedSpeed</hediff>
        <useEffect>NAT_ActivatorUsed_Speed</useEffect>
        <combatEnhancing>true</combatEnhancing>
      </li>
    </comps>
    <costList>
      <Neutroamine>5</Neutroamine>
    </costList>
  </ThingDef>

  <ThingDef ParentName="NAT_RustActivatorBase">
